# Database Configuration (MySQL 8+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ace_teamup
DB_USER=root
DB_PASSWORD=your_mysql_password

# Spring Security & JWT
APP_JWT_SECRET=aceTeamUpSuperSecretKeyForJWT2024PleaseChangeInProductionEnvironmentAtLeast256BitsLong
APP_JWT_EXPIRATION_MS=86400000

# Backend Server Port
SERVER_PORT=8080

# AI/ML Microservice
AI_SERVICE_URL=http://localhost:8000
SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_CACHE_SIZE=1000

# Weighted Compatibility Weights (sum = 1.0)
WEIGHT_SKILL=0.35
WEIGHT_INTEREST=0.25
WEIGHT_EXPERIENCE=0.15
WEIGHT_AVAILABILITY=0.15
WEIGHT_COLLABORATION=0.10

# OR-Tools Solver Time Limit (seconds)
ILP_TIME_LIMIT_SECONDS=30
